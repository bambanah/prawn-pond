{
	"compilerOptions": {
		"module": "commonjs",
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"outDir": "lib",
		"rootDir": "src",
		"sourceMap": true,
		"strict": true,
		"target": "es2022",
		"esModuleInterop": true,
		"typeRoots": ["node_modules/@types"]
	},
	"compileOnSave": true,
	"include": ["src"],
	"exclude": ["node_modules"]
}
